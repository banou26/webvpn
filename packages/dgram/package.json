{
  "name": "@webvpn/dgram",
  "version": "0.5.0",
  "description": "Node's dgram module for a web page, with its sockets on a WebVPN relay",
  "license": "MIT",
  "homepage": "https://webvpn.dev",
  "keywords": [
    "webvpn",
    "dgram",
    "udp",
    "sockets",
    "browser",
    "polyfill"
  ],
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vp build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test run",
    "test:unit": "vp test run --project unit",
    "test:browser": "vp test run --project browser"
  },
  "dependencies": {
    "@types/node": "^25.9.5",
    "@webvpn/client": "^0.5.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0"
  },
  "devDependencies": {
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "^1.56.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banou26/webvpn.git",
    "directory": "packages/dgram"
  },
  "publishConfig": {
    "access": "public"
  }
}
