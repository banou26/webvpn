{
  "name": "@webvpn/client",
  "version": "0.5.0",
  "description": "The WebVPN client: real TCP and UDP sockets for a web page, through a relay",
  "license": "MIT",
  "homepage": "https://webvpn.dev",
  "keywords": [
    "webvpn",
    "webtransport",
    "websocket",
    "tcp",
    "udp",
    "sockets",
    "browser"
  ],
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "files": [
    "build"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vp build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test run",
    "test:unit": "vp test run --project unit",
    "test:browser": "vp test run --project browser"
  },
  "dependencies": {
    "@banou/ponyfill": "^0.0.11"
  },
  "devDependencies": {
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "^1.56.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banou26/webvpn.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  }
}
